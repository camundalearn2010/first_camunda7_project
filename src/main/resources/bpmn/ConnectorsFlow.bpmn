    <bpmn:serviceTask id="Activity_0zft9tc" name="PostHttp">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${"https://reqres.in/api/users"}</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="JavaScript">var postrequest = {
                "name":"Suneel",
                "job":"Manager"
                };
postrequest = JSON.stringify(postrequest);
postrequest;</camunda:script>
            </camunda:inputParameter>
            <camunda:outputParameter name="PostOutput">
              <camunda:script scriptFormat="JavaScript">print('Post response : '+response);
response;</camunda:script>
            </camunda:outputParameter>
            <camunda:outputParameter name="ID">
              <camunda:script scriptFormat="JavaScript">var json = S(response);
var id= json.prop("id").value();
print ('ID :' +id);
id;</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05wkabj</bpmn:incoming>
      <bpmn:outgoing>Flow_0ip8fts</bpmn:outgoing>
