    <bpmn:serviceTask id="Activity_0cgohnj" name="Service-GetConnector Task">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">
              <camunda:script scriptFormat="JavaScript">myurl='https://reqres.in/api/users';
myurl = myurl + '/' + execution.getVariable("ID");
print("URL - " + myurl);
myurl;</camunda:script>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:outputParameter name="Out">
              <camunda:script scriptFormat="JavaScript">print('Get response :' + response);
JSON.stringify(response);</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
