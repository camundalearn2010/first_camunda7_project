    <bpmn:scriptTask id="Activity_00zqxxk" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_0qn76mf</bpmn:incoming>
      <bpmn:outgoing>Flow_077wpud</bpmn:outgoing>
      <bpmn:script>details = execution.getVariable("DishDetails");
print('Output Dish: '+ details);

print('****');

execution.setVariable("finalDishNameNew",DishDetails.get("finalDishName"));
execution.setVariable("DishStatusNew",DishDetails.get("DishStatus"));</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="Activity_0l6jalh" name="Get The Final Dish to be prepared" camunda:resultVariable="DishDetails" camunda:decisionRef="DishToPrepare" camunda:mapDecisionResult="singleResult">
