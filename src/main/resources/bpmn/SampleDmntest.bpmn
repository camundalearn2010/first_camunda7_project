    <bpmn:scriptTask id="Activity_1qc0206" name="Get the Guest count &#38; Day Event" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_119mpc5</bpmn:incoming>
      <bpmn:outgoing>Flow_024q81o</bpmn:outgoing>
      <bpmn:script>print('Before DMN');
execution.setVariable("dayEvent","Lunch");
execution.setVariable("guestCount",8);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0qn76mf" sourceRef="Activity_0l6jalh" targetRef="Activity_00zqxxk" />
