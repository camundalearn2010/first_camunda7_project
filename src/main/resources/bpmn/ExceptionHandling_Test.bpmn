  <bpmn:collaboration id="Collaboration_0fme3kj">
    <bpmn:participant id="Participant_0h66yw6" name="LoanApprovalProcess" processRef="LoanApprovalProcess" />
  </bpmn:collaboration>
  <bpmn:process id="LoanApprovalProcess" name="LoanApprovalProcess" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_03oir9w</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Activity_0h8qtvc" name="Apply Loan" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_03oir9w</bpmn:incoming>
      <bpmn:outgoing>Flow_0p6gto0</bpmn:outgoing>
      <bpmn:script>execution.setVariable("CustomerName",   "Suneel Kumar");
execution.setVariable("CustomerEmail",  "suneel.kumar@example.com");
execution.setVariable("CreditScore",  "750ab");
execution.setVariable("LoanAmount",  100000);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:subProcess id="Activity_1e979mo">
      <bpmn:incoming>Flow_0p6gto0</bpmn:incoming>
      <bpmn:outgoing>Flow_0o940j9</bpmn:outgoing>
      <bpmn:startEvent id="Event_1bplofz">
        <bpmn:outgoing>Flow_03ds6wx</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_03ds6wx" sourceRef="Event_1bplofz" targetRef="Activity_0iltazm" />
      <bpmn:serviceTask id="Activity_0iltazm" name="Check Credit Score" camunda:delegateExpression="${checkCreditScore}">
        <bpmn:incoming>Flow_03ds6wx</bpmn:incoming>
        <bpmn:outgoing>Flow_1ye8e8g</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Event_09q5lto">
        <bpmn:incoming>Flow_0xkdje2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="Gateway_19npsit" name="is Large Loan Amount?" default="Flow_0inb9xb">
        <bpmn:incoming>Flow_1ye8e8g</bpmn:incoming>
        <bpmn:outgoing>Flow_0inb9xb</bpmn:outgoing>
        <bpmn:outgoing>Flow_0r7kcrq</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_1ye8e8g" sourceRef="Activity_0iltazm" targetRef="Gateway_19npsit" />
      <bpmn:sequenceFlow id="Flow_0inb9xb" sourceRef="Gateway_19npsit" targetRef="Gateway_1z12uut" />
      <bpmn:sequenceFlow id="Flow_0r7kcrq" sourceRef="Gateway_19npsit" targetRef="Event_1gv0p69">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${LoanAmount &gt; 100000}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_0q6ejnw" sourceRef="Event_1gv0p69" targetRef="Gateway_1z12uut" />
      <bpmn:exclusiveGateway id="Gateway_1z12uut">
