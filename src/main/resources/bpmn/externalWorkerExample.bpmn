  <bpmn:process id="ExternalWorkerExample" name="External worker example" isExecutable="true" camunda:historyTimeToLive="P180D">
    <bpmn:startEvent id="StartEvent">
      <bpmn:outgoing>Flow_Start_To_Greeting</bpmn:outgoing>
