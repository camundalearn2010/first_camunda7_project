    <bpmn:serviceTask id="ExternalTask_Greeting" name="Create greeting" camunda:type="external" camunda:topic="greet-customer">
      <bpmn:incoming>Flow_0pf0kak</bpmn:incoming>
      <bpmn:outgoing>Flow_Greeting_To_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent">
      <bpmn:incoming>Flow_11g5gfe</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_To_Greeting" sourceRef="StartEvent" targetRef="Activity_0cxpqst" />
    <bpmn:sequenceFlow id="Flow_Greeting_To_End" sourceRef="ExternalTask_Greeting" targetRef="Activity_0iooufa" />
