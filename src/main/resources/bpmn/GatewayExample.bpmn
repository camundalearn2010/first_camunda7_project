  <bpmn:collaboration id="Collaboration_0kh2qg6">
    <bpmn:participant id="Participant_0fqwjx9" name="GatewayExample" processRef="GatewayExample" />
  </bpmn:collaboration>
  <bpmn:process id="GatewayExample" name="GatewayExample" isExecutable="true" camunda:historyTimeToLive="5">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_062dndm</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Activity_1d3aelo" name="Task1" scriptFormat="JavaScript" camunda:resultVariable="CheckA">
      <bpmn:incoming>Flow_062dndm</bpmn:incoming>
      <bpmn:outgoing>Flow_16ojke8</bpmn:outgoing>
      <bpmn:script>var a= false;
print('Execute Task1');
a;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_10o1zd7" default="Flow_05vfdbh">
      <bpmn:incoming>Flow_16ojke8</bpmn:incoming>
      <bpmn:outgoing>Flow_06od711</bpmn:outgoing>
      <bpmn:outgoing>Flow_05vfdbh</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Activity_06bma47" name="Task2" scriptFormat="JavaScript" camunda:resultVariable="TaskVar2">
      <bpmn:incoming>Flow_06od711</bpmn:incoming>
      <bpmn:outgoing>Flow_0hgonxq</bpmn:outgoing>
      <bpmn:script>print('Execute Task2');
var b= "task2";
b;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="Event_02ye4mo">
      <bpmn:incoming>Flow_0hgonxq</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="Activity_19s0glv" scriptFormat="JavaScript" camunda:resultVariable="myuserobj">
      <bpmn:incoming>Flow_05vfdbh</bpmn:incoming>
      <bpmn:outgoing>Flow_0mrxi0t</bpmn:outgoing>
      <bpmn:script>print('Exclusive Gateway finished');
var userObj= {
                "name":"Suneel",
                "job":"Manager",
                "location":"",
                "email":""
                };
userObj;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:parallelGateway id="Gateway_02rdo4y">
      <bpmn:incoming>Flow_0mrxi0t</bpmn:incoming>
      <bpmn:outgoing>Flow_08jejwp</bpmn:outgoing>
      <bpmn:outgoing>Flow_10wqigg</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:scriptTask id="Activity_1dojrsp" name="Assign Location" scriptFormat="JavaScript" camunda:resultVariable="Parallelobj">
      <bpmn:incoming>Flow_08jejwp</bpmn:incoming>
      <bpmn:outgoing>Flow_05cxvxy</bpmn:outgoing>
      <bpmn:script>obj = execution.getVariable("myuserobj");
obj.location = "Bangalore";
var test1=JSON.stringify(obj);
print ('Location Details' + test1);
test1;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_000zx9r" name="Add Email" scriptFormat="JavaScript" camunda:resultVariable="Parallelobj1">
      <bpmn:incoming>Flow_10wqigg</bpmn:incoming>
      <bpmn:outgoing>Flow_0j5s9wf</bpmn:outgoing>
      <bpmn:script>obj1 = execution.getVariable("myuserobj");
obj1.email= "raj@gmail.com";
var test2=JSON.stringify(obj1);
print ('Email Details' + test2);
test2;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:parallelGateway id="Gateway_1dmyd2h">
      <bpmn:incoming>Flow_05cxvxy</bpmn:incoming>
      <bpmn:incoming>Flow_0j5s9wf</bpmn:incoming>
      <bpmn:outgoing>Flow_14ewvuu</bpmn:outgoing>
    </bpmn:parallelGateway>
