    <bpmn:scriptTask id="Activity_0lhav0x" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_14ewvuu</bpmn:incoming>
      <bpmn:outgoing>Flow_07op9ov</bpmn:outgoing>
      <bpmn:script>var a = execution.getVariable("myuserobj");
print ('Final variable value :' + JSON.stringify(a));
execution.setVariable("experience",4);
execution.setVariable("study","Engineer");</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1ydlfak" sourceRef="Gateway_16s07pi" targetRef="Activity_08jwah1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${study == "Engineer"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0m01qsr" sourceRef="Gateway_16s07pi" targetRef="Activity_1j076vq">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${experience &gt; 5}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0n4q86k" sourceRef="Activity_08jwah1" targetRef="Gateway_0a1tok6" />
    <bpmn:sequenceFlow id="Flow_1nvld21" sourceRef="Activity_1j076vq" targetRef="Gateway_0a1tok6" />
    <bpmn:sequenceFlow id="Flow_1y8aod6" sourceRef="Gateway_0a1tok6" targetRef="Event_0mrdu3p" />
    <bpmn:sequenceFlow id="Flow_07op9ov" sourceRef="Activity_0lhav0x" targetRef="Gateway_16s07pi" />
    <bpmn:scriptTask id="Activity_08jwah1" name="Assign SoftwareEngineer" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_1ydlfak</bpmn:incoming>
      <bpmn:outgoing>Flow_0n4q86k</bpmn:outgoing>
      <bpmn:script>print('Software Engineer ');</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_1j076vq" name="Assign SeniorEngineer" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_0m01qsr</bpmn:incoming>
      <bpmn:outgoing>Flow_1nvld21</bpmn:outgoing>
      <bpmn:script>print('Senior Engineer ');</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:inclusiveGateway id="Gateway_16s07pi">
      <bpmn:incoming>Flow_07op9ov</bpmn:incoming>
      <bpmn:outgoing>Flow_1ydlfak</bpmn:outgoing>
      <bpmn:outgoing>Flow_0m01qsr</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:inclusiveGateway id="Gateway_0a1tok6">
