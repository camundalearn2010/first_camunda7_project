      <bpmn:incoming>Flow_1nvld21</bpmn:incoming>
      <bpmn:outgoing>Flow_1y8aod6</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:endEvent id="Event_0mrdu3p">
      <bpmn:incoming>Flow_1y8aod6</bpmn:incoming>
    </bpmn:endEvent>
